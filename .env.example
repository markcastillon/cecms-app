# Copy this file to ".env" and fill in the values. Never commit the real .env file.

# From Supabase > Project Settings > API. The app needs both to start.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The live website address, e.g. https://cecms-app-black.vercel.app
# Only used by the Android app: links in sign-up and password-reset emails open
# this site, because the app's own address (https://localhost) only exists on the phone.
# The website itself ignores it and uses its own address.
VITE_SITE_URL=
